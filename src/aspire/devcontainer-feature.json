{
    "id": "aspire",
    "version": "3.1.0",
    "name": "Aspire",
    "documentationURL": "https://github.com/microsoft/aspire-devcontainer-feature",
    "description": "Installs Aspire. See https://aspire.dev",
    "options": {
        "installCli": {
            "type": "boolean",
            "default": true,
            "description": "Whether to install the Aspire CLI."
        },
        "useDailyBuilds": {
            "type": "boolean",
            "default": false,
            "description": "Whether to install the latest daily Aspire CLI build instead of the stable release. Ignored when installCli is false."
        }
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "microsoft-aspire.aspire-vscode"
            ],
            "settings": {
                "remote.autoForwardPorts": true,
                "remote.autoForwardPortsSource": "hybrid",
                "remote.otherPortsAttributes": {
                    "onAutoForward": "ignore"
                }
            }
        }
    }
}